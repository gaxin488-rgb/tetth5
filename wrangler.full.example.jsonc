{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cinezero-web",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/health"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cinezero-db",
    "database_id": "DAN_DATABASE_ID_VAO_DAY"
  }],
  "r2_buckets": [{
    "binding": "VIDEO_BUCKET",
    "bucket_name": "cinezero-media"
  }],
  "vars": {
    "SITE_NAME": "CineZero",
    "ADMIN_UPLOAD_LIMIT_MB": "95"
  },
  "observability": { "enabled": true }
}
